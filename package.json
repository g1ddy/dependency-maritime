{
  "name": "@dependency-maritime/cli",
  "version": "0.1.0-beta.5",
  "type": "module",
  "main": "./dist/cli/index.js",
  "types": "./dist/cli/index.d.ts",
  "bin": {
    "maritime": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/g1ddy/dependency-maritime.git"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist/cli",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build:cli": "esbuild src/cli/main.ts --bundle --platform=node --format=esm --packages=external --banner:js=\"#!/usr/bin/env node\" --outfile=dist/cli/main.js && esbuild src/cli/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli/index.js && tsc -p tsconfig.cli.json && node -e \"fs.copyFileSync('dist/cli/cli/index.d.ts', 'dist/cli/index.d.ts')\"",
    "build": "npm run build:cli && tsc -b && vite build",
    "lint": "eslint .",
    "depcruise": "depcruise src --config config/.dependency-cruiser.cjs",
    "check:arch": "depcruise src --config config/.dependency-cruiser.cjs",
    "generate:graph": "node dist/cli/main.js graph --input .maritime --output docs/images/dependency-graph.svg",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest",
    "test:bench": "vitest bench -c vitest.bench.config.ts",
    "test:cli-package": "vitest run tests/cli-pack-smoke.test.ts tests/action-ref-resolution.test.ts tests/evidence-workflow.test.ts",
    "test:e2e": "playwright test",
    "test:screenshots": "playwright test -c config/playwright.screenshots.config.ts"
  },
  "dependencies": {
    "dependency-cruiser": "^17.3.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/dagre": "^0.7.53",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.10",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "@xyflow/react": "^12.10.0",
    "autoprefixer": "^10.4.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dagre": "^0.8.5",
    "elkjs": "^0.11.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.1.0",
    "graphology": "^0.26.0",
    "graphology-metrics": "^2.4.0",
    "graphology-types": "^0.24.8",
    "jsdom": "^27.4.0",
    "lucide-react": "^0.563.0",
    "papaparse": "^5.5.3",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "web-worker": "^1.5.0",
    "zustand": "^5.0.10"
  }
}
